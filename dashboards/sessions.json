{
  "version": 8,
  "title": "Claude Code · Sessions",
  "description": "Session list; clicking a row opens the per-session dashboard",
  "role": "",
  "owner": "",
  "tabs": [
    {
      "tabId": "default",
      "name": "Sessions",
      "panels": [
        {
          "id": "sessions_active",
          "type": "metric",
          "title": "Active now",
          "description": "Sessions with events in the last 5 minutes",
          "config": {
            "show_legends": false,
            "unit": "default",
            "decimals": 0
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT COUNT(DISTINCT session_id) as \"y_axis_1\" FROM \"claude_code\" WHERE _timestamp >= CAST(to_unixtime(now()) * 1000000 AS BIGINT) - 300000000",
              "customQuery": true,
              "fields": {
                "stream": "claude_code",
                "stream_type": "logs",
                "x": [],
                "y": [
                  {
                    "label": "Active",
                    "alias": "y_axis_1",
                    "column": "session_id",
                    "color": null
                  }
                ],
                "z": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": ""
              }
            }
          ],
          "layout": {
            "x": 0,
            "y": 0,
            "w": 64,
            "h": 10,
            "i": 1
          }
        },
        {
          "id": "sessions_total",
          "type": "metric",
          "title": "Sessions in period",
          "description": "",
          "config": {
            "show_legends": false,
            "unit": "default",
            "decimals": 0
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT COUNT(DISTINCT session_id) as \"y_axis_1\" FROM \"claude_code\"",
              "customQuery": true,
              "fields": {
                "stream": "claude_code",
                "stream_type": "logs",
                "x": [],
                "y": [
                  {
                    "label": "Sessions",
                    "alias": "y_axis_1",
                    "column": "session_id",
                    "color": null
                  }
                ],
                "z": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": ""
              }
            }
          ],
          "layout": {
            "x": 64,
            "y": 0,
            "w": 64,
            "h": 10,
            "i": 2
          }
        },
        {
          "id": "sessions_cost",
          "type": "metric",
          "title": "Cost for the period",
          "description": "",
          "config": {
            "show_legends": false,
            "unit": "custom",
            "unit_custom": "$",
            "decimals": 3
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT SUM(CAST(cost_usd AS DOUBLE)) as \"y_axis_1\" FROM \"claude_code\" WHERE event_name = 'api_request'",
              "customQuery": true,
              "fields": {
                "stream": "claude_code",
                "stream_type": "logs",
                "x": [],
                "y": [
                  {
                    "label": "USD",
                    "alias": "y_axis_1",
                    "column": "cost_usd",
                    "color": null
                  }
                ],
                "z": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": ""
              }
            }
          ],
          "layout": {
            "x": 128,
            "y": 0,
            "w": 64,
            "h": 10,
            "i": 3
          }
        },
        {
          "id": "sessions_table",
          "type": "table",
          "title": "Sessions (click a row → session details)",
          "description": "Status \"active\" = had an event in the last 5 minutes",
          "config": {
            "show_legends": false,
            "unit": "default",
            "wrap_table_cells": true,
            "drilldown": [
              {
                "name": "Open session",
                "type": "byDashboard",
                "targetBlank": false,
                "findBy": "name",
                "data": {
                  "folder": "default",
                  "dashboard": "Claude Code · Session",
                  "tab": "Session",
                  "passAllVariables": false,
                  "variables": [
                    {
                      "name": "session_id",
                      "value": "${row.field[\"Session\"]}"
                    }
                  ]
                }
              }
            ]
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT session_id as \"x_axis_1\", CASE WHEN MAX(_timestamp) >= CAST(to_unixtime(now()) * 1000000 AS BIGINT) - 300000000 THEN '● active' ELSE '—' END as \"y_axis_1\", MAX(event_timestamp) as \"y_axis_2\", SUM(CASE WHEN event_name = 'user_prompt' THEN 1 ELSE 0 END) as \"y_axis_3\", SUM(CASE WHEN event_name = 'tool_decision' THEN 1 ELSE 0 END) as \"y_axis_4\", SUM(CAST(cost_usd AS DOUBLE)) as \"y_axis_5\", MAX(model) as \"y_axis_6\" FROM \"claude_code\" GROUP BY x_axis_1 ORDER BY y_axis_2 DESC",
              "customQuery": true,
              "fields": {
                "stream": "claude_code",
                "stream_type": "logs",
                "x": [
                  {
                    "label": "Session",
                    "alias": "x_axis_1",
                    "column": "session_id",
                    "color": null
                  }
                ],
                "y": [
                  {
                    "label": "Status",
                    "alias": "y_axis_1",
                    "column": "event_name",
                    "color": null
                  },
                  {
                    "label": "Last activity",
                    "alias": "y_axis_2",
                    "column": "event_timestamp",
                    "color": null
                  },
                  {
                    "label": "Prompts",
                    "alias": "y_axis_3",
                    "column": "event_name",
                    "color": null
                  },
                  {
                    "label": "Tools",
                    "alias": "y_axis_4",
                    "column": "event_name",
                    "color": null
                  },
                  {
                    "label": "USD",
                    "alias": "y_axis_5",
                    "column": "cost_usd",
                    "color": null
                  },
                  {
                    "label": "Model",
                    "alias": "y_axis_6",
                    "column": "model",
                    "color": null
                  }
                ],
                "z": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": ""
              }
            }
          ],
          "layout": {
            "x": 0,
            "y": 10,
            "w": 192,
            "h": 22,
            "i": 4
          }
        },
        {
          "id": "sessions_activity",
          "type": "stacked",
          "title": "Session activity over time",
          "description": "",
          "config": {
            "show_legends": true,
            "legends_position": "bottom",
            "unit": "default",
            "decimals": 0
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT histogram(_timestamp) as \"x_axis_1\", COUNT(*) as \"y_axis_1\", session_id as \"breakdown_1\" FROM \"claude_code\" GROUP BY x_axis_1, breakdown_1 ORDER BY x_axis_1",
              "customQuery": true,
              "fields": {
                "stream": "claude_code",
                "stream_type": "logs",
                "x": [
                  {
                    "label": "Time",
                    "alias": "x_axis_1",
                    "column": "_timestamp",
                    "color": null
                  }
                ],
                "y": [
                  {
                    "label": "Events",
                    "alias": "y_axis_1",
                    "column": "event_name",
                    "color": null
                  }
                ],
                "z": [],
                "breakdown": [
                  {
                    "label": "Session",
                    "alias": "breakdown_1",
                    "column": "session_id",
                    "color": null
                  }
                ],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": ""
              }
            }
          ],
          "layout": {
            "x": 0,
            "y": 32,
            "w": 192,
            "h": 18,
            "i": 5
          }
        }
      ]
    }
  ]
}
