{
  "version": 8,
  "title": "Claude Code · Overview",
  "description": "Start screen: limits, spend, live sessions, recent prompts",
  "role": "",
  "owner": "",
  "defaultDatetimeDuration": {
    "type": "relative",
    "relativeTimePeriod": "6h"
  },
  "tabs": [
    {
      "tabId": "default",
      "name": "Overview",
      "panels": [
        {
          "id": "o_5h",
          "type": "gauge",
          "title": "5-hour limit",
          "description": "",
          "config": {
            "show_legends": false,
            "unit": "percent",
            "decimals": 0
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT five_hour_used as \"y_axis_1\" FROM \"claude_code_limits\" ORDER BY _timestamp DESC LIMIT 1",
              "customQuery": true,
              "fields": {
                "stream": "claude_code_limits",
                "stream_type": "logs",
                "x": [],
                "y": [
                  {
                    "label": "5h, %",
                    "alias": "y_axis_1",
                    "column": "five_hour_used",
                    "color": null
                  }
                ],
                "z": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": "",
                "min": 0,
                "max": 100
              }
            }
          ],
          "layout": {
            "x": 0,
            "y": 0,
            "w": 38,
            "h": 13,
            "i": 1
          }
        },
