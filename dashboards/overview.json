        },
        {
          "id": "o_tools",
          "type": "h-bar",
          "title": "Top tools",
          "description": "",
          "config": {
            "show_legends": false,
            "unit": "default",
            "decimals": 0
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT tool_name as \"x_axis_1\", COUNT(*) as \"y_axis_1\" FROM \"claude_code\" WHERE event_name = 'tool_decision' GROUP BY x_axis_1 ORDER BY y_axis_1 DESC",
              "customQuery": true,
              "fields": {
                "stream": "claude_code",
                "stream_type": "logs",
                "x": [
                  {
                    "label": "Tool",
                    "alias": "x_axis_1",
                    "column": "tool_name",
                    "color": null
                  }
                ],
                "y": [
                  {
                    "label": "Calls",
                    "alias": "y_axis_1",
                    "column": "tool_name",
                    "color": null
                  }
                ],
                "z": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": ""
              }
            }
          ],
          "layout": {
            "x": 96,
            "y": 13,
            "w": 96,
            "h": 18,
            "i": 7
          }
        },
        {
          "id": "o_sessions",
          "type": "table",
          "title": "Sessions (click a row → session details)",
          "description": "",
          "config": {
            "show_legends": false,
            "unit": "default",
            "wrap_table_cells": true,
            "drilldown": [
              {
                "name": "Open session",
                "type": "byDashboard",
                "targetBlank": false,
                "findBy": "name",
                "data": {
                  "folder": "default",
                  "dashboard": "Claude Code · Session",
                  "tab": "Session",
                  "passAllVariables": false,
                  "variables": [
                    {
                      "name": "session_id",
                      "value": "${row.field[\"Session\"]}"
                    }
                  ]
                }
              }
            ]
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT session_id as \"x_axis_1\", CASE WHEN MAX(_timestamp) >= CAST(to_unixtime(now()) * 1000000 AS BIGINT) - 300000000 THEN '● active' ELSE '—' END as \"y_axis_1\", MAX(event_timestamp) as \"y_axis_2\", SUM(CASE WHEN event_name = 'user_prompt' THEN 1 ELSE 0 END) as \"y_axis_3\", SUM(CAST(cost_usd AS DOUBLE)) as \"y_axis_4\", MAX(model) as \"y_axis_5\" FROM \"claude_code\" GROUP BY x_axis_1 ORDER BY y_axis_2 DESC",
              "customQuery": true,
              "fields": {
                "stream": "claude_code",
                "stream_type": "logs",
                "x": [
                  {
                    "label": "Session",
                    "alias": "x_axis_1",
                    "column": "session_id",
                    "color": null
                  }
                ],
                "y": [
                  {
                    "label": "Status",
                    "alias": "y_axis_1",
                    "column": "event_name",
                    "color": null
                  },
                  {
                    "label": "Last activity",
                    "alias": "y_axis_2",
                    "column": "event_timestamp",
                    "color": null
                  },
                  {
                    "label": "Prompts",
                    "alias": "y_axis_3",
                    "column": "event_name",
                    "color": null
                  },
                  {
                    "label": "USD",
                    "alias": "y_axis_4",
                    "column": "cost_usd",
                    "color": null
                  },
                  {
                    "label": "Model",
                    "alias": "y_axis_5",
                    "column": "model",
                    "color": null
                  }
                ],
                "z": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": ""
              }
            }
          ],
          "layout": {
            "x": 0,
            "y": 31,
            "w": 192,
            "h": 20,
            "i": 8
          }
        },
        {
          "id": "o_prompts",
          "type": "table",
          "title": "Recent prompts",
          "description": "",
          "config": {
            "show_legends": false,
            "unit": "default",
            "wrap_table_cells": true
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT event_timestamp as \"x_axis_1\", prompt as \"y_axis_1\", session_id as \"y_axis_2\" FROM \"claude_code\" WHERE event_name = 'user_prompt' ORDER BY x_axis_1 DESC",
              "customQuery": true,
              "fields": {
                "stream": "claude_code",
                "stream_type": "logs",
                "x": [
                  {
                    "label": "Time",
                    "alias": "x_axis_1",
                    "column": "event_timestamp",
                    "color": null
                  }
                ],
                "y": [
                  {
                    "label": "Prompt",
                    "alias": "y_axis_1",
                    "column": "prompt",
                    "color": null
                  },
                  {
                    "label": "Session",
                    "alias": "y_axis_2",
                    "column": "session_id",
                    "color": null
                  }
                ],
                "z": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": ""
              }
            }
          ],
          "layout": {
            "x": 0,
            "y": 51,
            "w": 192,
            "h": 20,
            "i": 9
          }
        }
