            "show_legends": false,
            "unit": "numbers",
            "decimals": 1
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT SUM(value) as \"y_axis_1\" FROM \"claude_code_token_usage\"",
              "customQuery": true,
              "fields": {
                "stream": "claude_code_token_usage",
                "stream_type": "metrics",
                "x": [],
                "y": [
                  {
                    "label": "Tokens",
                    "alias": "y_axis_1",
                    "column": "value",
                    "color": null
                  }
                ],
                "z": [],
                "filter": {
                  "filterType": "group",
