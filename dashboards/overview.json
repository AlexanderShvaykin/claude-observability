        },
        {
          "id": "o_cost_time",
          "type": "stacked",
          "title": "Spend over time by model",
          "description": "",
          "config": {
            "show_legends": true,
            "legends_position": "bottom",
            "unit": "custom",
            "unit_custom": "$",
            "decimals": 4
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT histogram(_timestamp) as \"x_axis_1\", SUM(value) as \"y_axis_1\", model as \"breakdown_1\" FROM \"claude_code_cost_usage\" GROUP BY x_axis_1, breakdown_1 ORDER BY x_axis_1",
              "customQuery": true,
              "fields": {
                "stream": "claude_code_cost_usage",
                "stream_type": "metrics",
                "x": [
                  {
                    "label": "Time",
                    "alias": "x_axis_1",
                    "column": "_timestamp",
                    "color": null
                  }
                ],
                "y": [
                  {
                    "label": "USD",
                    "alias": "y_axis_1",
                    "column": "value",
                    "color": null
                  }
                ],
                "z": [],
                "breakdown": [
                  {
                    "label": "Model",
                    "alias": "breakdown_1",
                    "column": "model",
                    "color": null
                  }
                ],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": ""
              }
            }
          ],
          "layout": {
            "x": 0,
            "y": 13,
            "w": 96,
            "h": 18,
            "i": 6
