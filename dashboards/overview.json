          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT COUNT(DISTINCT session_id) as \"y_axis_1\" FROM \"claude_code\" WHERE _timestamp >= CAST(to_unixtime(now()) * 1000000 AS BIGINT) - 300000000",
              "customQuery": true,
              "fields": {
                "stream": "claude_code",
                "stream_type": "logs",
                "x": [],
                "y": [
                  {
                    "label": "Sessions",
                    "alias": "y_axis_1",
